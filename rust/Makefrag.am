# Makefile fragment for the Rust part of GNU Mach.

# The crate, as rustc sees it: one root, and the modules it pulls in.
MACH_RS_SRCS = \
	rust/src/arch.rs \
	rust/src/arch/i386/atomic_bits.rs \
	rust/src/arch/i386/io_req.rs \
	rust/src/arch/i386/kd/console.rs \
	rust/src/arch/i386/kd/display.rs \
	rust/src/arch/i386/kd/esc.rs \
	rust/src/arch/i386/kd/keyboard.rs \
	rust/src/arch/i386/kd/keymap.rs \
	rust/src/arch/i386/kd/mod.rs \
	rust/src/arch/i386/kd/tty.rs \
	rust/src/arch/i386/kd_event.rs \
	rust/src/arch/i386/kd_mouse.rs \
	rust/src/arch/i386/mbinfo.rs \
	rust/src/arch/i386/mem.rs \
	rust/src/arch/i386/mod.rs \
	rust/src/arch/i386/percpu.rs \
	rust/src/arch/types.rs \
	rust/src/arch/vm_param.rs \
	rust/src/glue/mig.rs \
	rust/src/glue/mod.rs \
	rust/src/glue/time_value.rs \
	rust/src/ipc/ipc_thread.rs \
	rust/src/ipc/mod.rs \
	rust/src/kern/ast.rs \
	rust/src/kern/elf_load.rs \
	rust/src/kern/kmutex.rs \
	rust/src/kern/list.rs \
	rust/src/kern/lock.rs \
	rust/src/kern/mach_clock.rs \
	rust/src/kern/machine.rs \
	rust/src/kern/mod.rs \
	rust/src/kern/policy.rs \
	rust/src/kern/processor.rs \
	rust/src/kern/processor_info.rs \
	rust/src/kern/queue.rs \
	rust/src/kern/rbtree.rs \
	rust/src/kern/sched.rs \
	rust/src/kern/sched_prim.rs \
	rust/src/kern/smp.rs \
	rust/src/kern/timer.rs \
	rust/src/kern/thread.rs \
	rust/src/kern/types.rs \
	rust/src/lib.rs \
	rust/src/panic.rs \
	rust/src/spin/barrier.rs \
	rust/src/spin/lazylock.rs \
	rust/src/spin/mod.rs \
	rust/src/spin/mutex.rs \
