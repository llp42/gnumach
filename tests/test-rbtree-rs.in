# rust/src/kern/rbtree.rs carries `#[cfg(test)]` tests and no kernel
# dependencies, so the host compiler can run them directly.  This is the
# one Rust module tested this way; everything else is exercised through
# the qemu suite.

set -eu

: "${RBTREE_RS:?RBTREE_RS must point at rust/src/kern/rbtree.rs}"
rustc=${RUSTC:-@RUSTC@}
out=${TMPDIR:-/tmp}/test-rbtree-$$

trap 'rm -f "$out"' EXIT HUP INT TERM

"$rustc" --edition 2024 --test -D warnings -O "$RBTREE_RS" -o "$out"
"$out"

# Local Variables:
# mode: shell-script
# End:
