#
# Tests.
#

# Let user specify a kernel to test
GNUMACH ?= gnumach
export GNUMACH

.NOTPARALLEL: check

include tests/user-qemu.mk

TESTS += \
	tests/test-multiboot \
	tests/test-rbtree-rs \
	$(USER_TESTS)

# The rbtree module is the one Rust file with host unit tests; the
# configured script needs to know where it lives.
RBTREE_RS = $(srcdir)/rust/src/kern/rbtree.rs
export RBTREE_RS

EXTRA_DIST += \
	tests/README \
	tests/grub.cfg.single.template \
	tests/run-qemu.sh.template \
	tests/include/string.h \
	tests/include/syscalls.h \
	tests/include/testlib.h \
	tests/include/device/cons.h \
	tests/include/kern/printf.h \
	tests/include/mach/mig_support.h \
	tests/include/sys/reboot.h \
	tests/include/util/atoi.h \
	tests/hmp_send.c \
	tests/kd.c \
	tests/kd.h \
	tests/kd_device.h \
	tests/kd_event.c \
	tests/kd_event.h \
	tests/kd_mouse.c \
	tests/kd_mouse.h \
	tests/kd_queue.c \
	tests/kd_queue.h \
	$(USER_TESTS:%=%.c) \
	$(TESTSRC_TESTLIB)

clean-local: $(USER_TESTS_CLEAN)
	rm -fr tests/include-mach tests/test-multiboot tests/test-rbtree-rs
	rm -fr tests/errlist.c tests/mig-out
	rm -f tests/hmp-send
